# ─────────────────────────────────────────────────────────────────────────────
# spec-plan-writer · environment contract
#
# Local dev is ONE process (`npm run dev`). Leave RIVET_* unset and RivetKit
# starts a local engine on :6420 that calls back into `/api/rivet` on Vite.
# GitHub OAuth is the only thing you MUST configure to log in.
#
# Production (Vercel serverless): set RIVET_ENDPOINT + RIVET_PUBLIC_ENDPOINT
# from Rivet Cloud. See https://rivet.dev/docs/deploy/vercel
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (required) ──────────────────────────────────────────────────────────
# Create a GitHub OAuth App: https://github.com/settings/developers
# Prefer 127.0.0.1 (not localhost) so IPv4 matches Rivet's local engine pool:
#   Homepage URL:              http://127.0.0.1:5173            (dev)
#   Authorization callback URL: http://127.0.0.1:5173/auth/github/callback
# Scopes requested: `read:user` (profile) + `repo` (read repo files, open PRs).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HS256 signing secret for session cookies + actor tokens (>= 32 chars).
#   generate: openssl rand -hex 32
AUTH_SECRET=

# Shared secret for server-side / actor-to-actor calls (>= 32 chars).
# Used to stamp internal connections to run/worker/vm (browser JWT rejected).
#   generate: openssl rand -hex 32
INTERNAL_SECRET=

# ── Rivet ────────────────────────────────────────────────────────────────────
# Topology: the browser opens its WebSocket to Rivet. Rivet then makes ordinary
# HTTPS requests back to this deployment at /api/rivet/* (metadata + start).
# Get both tokens from Rivet Dashboard → Settings → Advanced → Cloud API Tokens
# URL-auth form: https://<namespace>:<token>@api.rivet.dev
#
# Leave BOTH unset locally to run the bundled dev engine on :6420.

# SERVER ONLY — SECRET (sk_). Required on Vercel. Without it RivetKit falls
# back to the filesystem driver, which fails on Vercel's read-only FS:
#   Error: ENOENT: no such file or directory, mkdir '.../rivetkit/.../state'
RIVET_ENDPOINT=

# PUBLISHED TO THE BROWSER — publishable (pk_). Served by GET /api/rivet/metadata.
# Without it metadata returns 200 but omits clientEndpoint/clientNamespace/clientToken.
RIVET_PUBLIC_ENDPOINT=

# URL Rivet/engine uses as the serverless pool callback (…/api/rivet).
# Prod: usually derived from APP_URL. Override if the public origin differs.
# Local default: http://127.0.0.1:5173/api/rivet
# RIVET_SERVERLESS_URL=https://spec-plan-writer.vercel.app/api/rivet
# RIVET_DEV_SERVERLESS_URL=http://127.0.0.1:5173/api/rivet
#
# Pool timings (set in code via configurePool — do not leave dashboard defaults):
#   request_lifespan = 280s   (< Vercel maxDuration 300)
#   drain_grace_period = 30s  (MUST be < request_lifespan; default 1800 is invalid)

# If Vercel Deployment Protection is on: create a bypass secret in Vercel, then
# Rivet → Settings → Providers → Edit → Add Header
#   x-vercel-protection-bypass = <secret>
# Otherwise Rivet's /api/rivet/* calls get 401 Authentication Required.

# Comma-separated WebSocket origin allowlist for actor connections.
# Empty + RIVET_ENDPOINT set = hard deny. Local dev allows everything.
#   prod: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# Public origin of the app (OAuth callback URL + cookie Secure flag).
# Defaults to http://localhost:5173 in dev.
APP_URL=

# ── Shared agent filesystem (S3) — optional ──────────────────────────────────
# Per-plan agentOS VM mounts this bucket/prefix at /home/agentos/work.
# Any S3-compatible store (AWS S3, R2, MinIO, …). Unset → VM built-in FS.
SPEC_S3_BUCKET=
SPEC_S3_REGION=auto
SPEC_S3_ENDPOINT=
SPEC_S3_ACCESS_KEY_ID=
SPEC_S3_SECRET_ACCESS_KEY=
# Key prefix; per-plan data at <PREFIX>plans/<userId>/<planId>/
SPEC_S3_PREFIX=spec-plan-writer/

# ── Vercel Blob (spec artifacts) — optional ──────────────────────────────────
# Finished SPEC.md uploaded privately to plans/<userId>/<planId>/SPEC.md.
# Leave unset to keep the doc only in the plan actor's SQLite.
BLOB_READ_WRITE_TOKEN=

# ── Models ───────────────────────────────────────────────────────────────────
# Every LLM call routes through the USER's OpenRouter key (onboarding — never
# your own). These only pick which models are used.
SPEC_PLAN_MODEL=openai/gpt-oss-120b:nitro
# Model pi coding agents use inside the VMs:
PI_MODEL=openai/gpt-oss-120b:nitro
# Max specialists working in parallel per run (1–8):
SPEC_PLAN_MAX_PARALLEL=4
