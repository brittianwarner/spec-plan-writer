# ─────────────────────────────────────────────────────────────────────────────
# spec-plan-writer · environment contract
#
# Local dev runs ZERO-CONFIG for the actor stack (no RIVET_* vars → the actor
# server starts the bundled local Rivet engine on :6420). GitHub OAuth is the
# only thing you MUST configure to log in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (required) ──────────────────────────────────────────────────────────
# Create a GitHub OAuth App: https://github.com/settings/developers
#   Homepage URL:              http://localhost:5173            (dev)
#   Authorization callback URL: http://localhost:5173/auth/github/callback
# Scopes requested: `read:user` (profile) + `repo` (read repo files, open PRs).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HS256 signing secret for session cookies + actor tokens (>= 32 chars).
#   generate: openssl rand -hex 32
AUTH_SECRET=

# Shared secret for server-side / actor-to-actor calls (>= 32 chars).
# Used to stamp internal connections to run/worker/vm (browser JWT rejected).
#   generate: openssl rand -hex 32
INTERNAL_SECRET=

# ── Rivet (production) ───────────────────────────────────────────────────────
# Rivet Cloud project → Settings → Cloud API Tokens. Leave BOTH unset locally
# to run the bundled dev engine instead of Rivet Cloud.
#
# Server secret (sk_): used by the SvelteKit server (OAuth callback, token
# minting) and by the actor server on Rivet Compute (injected for you there).
RIVET_ENDPOINT=
# Publishable (pk_): published to the browser for its direct WebSocket to
# Rivet Cloud. Safe to expose.
RIVET_PUBLIC_ENDPOINT=

# Comma-separated WebSocket origin allowlist for actor connections.
# Empty + RIVET_ENDPOINT set = hard deny. Local dev allows everything.
#   prod: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# Public origin of the app (used to build the OAuth callback URL).
# Defaults to http://localhost:5173 in dev.
APP_URL=

# ── Shared agent filesystem (S3) — optional ──────────────────────────────────
# The per-plan agentOS VM mounts this bucket/prefix at /home/agentos/work so
# the repo clone, worker sections, and SPEC.md persist and survive VM sleep.
# Any S3-compatible store works (AWS S3, Cloudflare R2, MinIO, ...).
# When unset, the VM's built-in persisted filesystem is used instead — the app
# works identically, just without the detached block-store durability.
SPEC_S3_BUCKET=
SPEC_S3_REGION=auto
SPEC_S3_ENDPOINT=
SPEC_S3_ACCESS_KEY_ID=
SPEC_S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket; per-plan data lands at
# <PREFIX>plans/<userId>/<planId>/
SPEC_S3_PREFIX=spec-plan-writer/

# ── Vercel Blob (spec artifacts) — optional ──────────────────────────────────
# Set this on the RIVET COMPUTE actor host (not only Vercel). Final SPEC.md is
# uploaded privately to plans/<userId>/<planId>/SPEC.md. Leave unset to keep
# the doc only in the plan actor's SQLite.
BLOB_READ_WRITE_TOKEN=

# ── Models ───────────────────────────────────────────────────────────────────
# Every LLM call routes through the USER's OpenRouter key (collected at
# onboarding — never your own). These only pick which models are used.
# Verification ping + planner + worker default:
SPEC_PLAN_MODEL=openai/gpt-oss-120b:nitro
# Model the pi coding agents run inside the VMs (registered into pi's
# models.json — see src/lib/actors/spec-plan-run/pi-config.ts):
PI_MODEL=openai/gpt-oss-120b:nitro
# Max specialists working in parallel per run (1–8):
SPEC_PLAN_MAX_PARALLEL=4
