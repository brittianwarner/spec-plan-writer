{
	"name": "spec-plan-writer",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:actors": "node src/server/actor-server.ts",
		"build": "vite build",
		"vercel-build": "node scripts/vercel-prebuild.mjs && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:unit": "vitest run",
		"test": "npm run test:unit",
		"smoke:openrouter": "node scripts/or-smoke.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.1.1",
		"@sveltejs/kit": "^2.48.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^24",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.55.9",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.2",
		"vitest": "^4.0.10"
	},
	"dependencies": {
		"@agentos-software/pi": "0.2.7",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"@rivet-dev/agentos": "0.2.15",
		"@rivetkit/svelte": "file:./rivetkit-svelte",
		"@vercel/blob": "^2.0.0",
		"ai": "7.0.37",
		"jose": "^6.0.12",
		"rivetkit": "2.3.10",
		"zod": "4.4.3"
	},
	"overrides": {
		"rivetkit": "2.3.10"
	}
}
